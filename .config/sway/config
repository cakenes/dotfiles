set $mod Mod4
floating_modifier $mod

input "type:keyboard" {
    xkb_layout fi
}

input "type:pointer" {
    accel_profile flat
    pointer_accel 0
}

seat * xcursor_theme Breeze_Light 24
# adaptive_sync disabled — unreliable with NVIDIA + sway --unsupported-gpu
# output * adaptive_sync on

# Workspace names
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"

# Game Mode
mode "Game" {
    bindsym $mod+Shift+e mode "default"

    bindsym $mod+1 workspace $ws1
    bindsym $mod+2 workspace $ws2
    bindsym $mod+3 workspace $ws3
    bindsym $mod+4 workspace $ws4
    bindsym $mod+5 workspace $ws5
    bindsym $mod+6 workspace $ws6
    bindsym $mod+7 workspace $ws7
    bindsym $mod+8 workspace $ws8
    bindsym $mod+9 workspace $ws9

    # move to workspace
    bindsym $mod+Shift+1 move container to workspace $ws1
    bindsym $mod+Shift+2 move container to workspace $ws2
    bindsym $mod+Shift+3 move container to workspace $ws3
    bindsym $mod+Shift+4 move container to workspace $ws4
    bindsym $mod+Shift+5 move container to workspace $ws5
    bindsym $mod+Shift+6 move container to workspace $ws6
    bindsym $mod+Shift+7 move container to workspace $ws7
    bindsym $mod+Shift+8 move container to workspace $ws8
    bindsym $mod+Shift+9 move container to workspace $ws9
}

bindsym $mod+e exec --no-startup-id nautilus -w
bindsym $mod+w exec --no-startup-id waterfox
bindsym $mod+Return exec --no-startup-id alacritty
bindsym Print exec grimshot copy screen
bindsym $mod+Print exec grimshot copy active
bindsym $mod+Shift+Print exec grimshot copy area
bindsym $mod+c exec --no-startup-id galculator
bindsym $mod+n exec --no-startup-id alacritty --class btop -o "window.dimensions.lines=40" -o "window.dimensions.columns=180" -e btop
bindsym $mod+d exec --no-startup-id qs -c noctalia-shell ipc call launcher toggle
bindsym $mod+l exec --no-startup-id qs -c noctalia-shell ipc call lockScreen lock
bindsym $mod+Shift+F5 exec --no-startup-id swaymsg "output HDMI-A-1 res 3440x1440 pos 0 0; output DP-1 disable; output DP-2 disable"
bindsym $mod+Shift+F6 exec --no-startup-id swaymsg "output DP-2 res 1680x1050 pos 0 0; output DP-1 disable; output HDMI-A-1 disable"
bindsym $mod+Shift+F7 exec --no-startup-id swaymsg "output DP-2 res 3440x1440 pos 0 0; output HDMI-A-1 res 3440x1440 pos 3440 0; output DP-1 disable"
bindsym $mod+Shift+F8 exec --no-startup-id swaymsg "output DP-1 res 3440x1440 pos 0 0; output DP-2 res 3440x1440 pos 3440 0; output HDMI-A-1 disable"

# Kill focused window
bindsym $mod+q exec --no-startup-id ~/.config/scripts/kill.sh
bindsym $mod+Shift+q [con_id="__focused__" instance="^(?!dropdown_).*$"] kill

# Change focus
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focus workspace
bindsym $mod+Ctrl+Shift+Right move workspace to output right
bindsym $mod+Ctrl+Shift+Left move workspace to output left

# Move focus window
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Resize focus window
bindsym $mod+Ctrl+Right resize grow right
bindsym $mod+Ctrl+Left resize grow left
bindsym $mod+Ctrl+Up resize grow up
bindsym $mod+Ctrl+Down resize grow down

# Toggle tiling / floating
bindsym $mod+space floating toggle

# Split in direction
bindsym $mod+v split v
bindsym $mod+h split h

# Layout fullscreen / gaps
bindsym $mod+f fullscreen toggle

# Gaps (Sway supports basic gaps)
bindsym $mod+KP_Add gaps inner current set 8; gaps outer current set 0
bindsym $mod+KP_Subtract gaps inner current set 0; gaps outer current set 0

# Layout split / tabbed
bindsym $mod+s layout toggle split
bindsym $mod+Shift+s layout tabbed
bindsym $mod+Ctrl+s layout tabbed

# Reload, restart, exit
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'"

# client.focused | client.focused_inactive | client.unfocused | client.urgent | client.placeholder | client.background
client.focused #195092 #195092 #FFFFFF #195092 #195092
client.focused_inactive #000000 #000000 #195092 #195092 #000000
client.unfocused #000000 #000000 #195092 #195092 #000000
client.urgent #5294e2 #5294e2 #FFFFFF #5294e2 #5294e2
client.placeholder #000000 #000000 #195092 #195092 #000000
client.background #000000

# Default gaps
default_border pixel 1
default_floating_border pixel 1
gaps inner 8
gaps outer 0

# Switch to workspace
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym --whole-window $mod+button4 workspace prev
bindsym --whole-window $mod+button5 workspace next
bindsym $mod+Tab workspace next

# Switch to workspace alternative
bindsym Ctrl+Shift+1 workspace $ws1
bindsym Ctrl+Shift+2 workspace $ws2
bindsym Ctrl+Shift+3 workspace $ws3
bindsym Ctrl+Shift+4 workspace $ws4
bindsym Ctrl+Shift+5 workspace $ws5
bindsym Ctrl+Shift+6 workspace $ws6
bindsym Ctrl+Shift+7 workspace $ws7
bindsym Ctrl+Shift+8 workspace $ws8
bindsym Ctrl+Shift+9 workspace $ws9

# Move to workspace
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9

# Move alternative (Ctrl)
bindsym $mod+Ctrl+1 move container to workspace $ws1
bindsym $mod+Ctrl+2 move container to workspace $ws2
bindsym $mod+Ctrl+3 move container to workspace $ws3
bindsym $mod+Ctrl+4 move container to workspace $ws4
bindsym $mod+Ctrl+5 move container to workspace $ws5
bindsym $mod+Ctrl+6 move container to workspace $ws6
bindsym $mod+Ctrl+7 move container to workspace $ws7
bindsym $mod+Ctrl+8 move container to workspace $ws8
bindsym $mod+Ctrl+9 move container to workspace $ws9

# Workspaces on monitors (Assign outputs to workspaces)
workspace $ws1 output DP-2
workspace $ws2 output DP-2
workspace $ws3 output DP-2
workspace $ws4 output DP-2
workspace $ws5 output DP-2
workspace $ws6 output DP-2
workspace $ws7 output DP-2
workspace $ws8 output DP-2
workspace $ws9 output DP-1

# Workspace assign
assign [class="discord"] $ws1
assign [class="steam" title="Steam"] $ws2
assign [class="Lutris"] $ws2
assign [class="bottles"] $ws2
assign [class="battle.net.exe"] $ws2
assign [class="riotclientux.exe"] $ws2

for_window [class=".*"] fullscreen disable
for_window [app_id=".*"] fullscreen disable

# Floating windows (class = XWayland, app_id = native Wayland)
for_window [class="Galculator"] floating enable
for_window [app_id="galculator"] floating enable
for_window [class="Pavucontrol"] floating enable
for_window [app_id="pavucontrol"] floating enable
for_window [class="Nm-connection-editor"] floating enable
for_window [app_id="nm-connection-editor"] floating enable
for_window [class="Blueman-manager"] floating enable
for_window [app_id="blueman-manager"] floating enable
for_window [class="Usbimager"] floating enable
for_window [app_id="usbimager"] floating enable
for_window [class="qt5ct"] floating enable
for_window [app_id="qt5ct"] floating enable
for_window [class="Xfce4-.*settings.*"] floating enable
for_window [class="Xfce4-.*manager.*"] floating enable
for_window [title="Emulator"] floating enable
for_window [class="Nvidia-settings"] floating enable
for_window [app_id="nvidia-settings"] floating enable
for_window [class="btop"] floating enable
for_window [app_id="btop"] floating enable
for_window [app_id="anki"] floating enable

# Steam specific
for_window [class="steam" title="Friends List"] floating enable
for_window [class="steam" title="Settings"] floating enable

# Games
for_window [class="trackmania.exe"] floating enable
for_window [title="World of Warracft"] windowed enable
for_window [class="Minecraft*"] floating enable
for_window [class="d2r.exe"] floating enable
for_window [class="Project Zomboid"] floating enable
for_window [class="scrcpy"] floating enable
for_window [title="Vampire Survivors"] floating enable
for_window [title="Brighter Shores"] floating enable
for_window [title="Brighter Shores"] resize set 1920 900

# Borders
for_window [title="xfce4-panel"] border none
for_window [class="OxygenNotIncluded"] border none
for_window [class="^steam_app.*"] border none

# Sticky
for_window [class="firefox" title="Picture-in-Picture"] sticky enable

# Custom macros
bindsym F11 --release exec --no-startup-id killall buy.sh

# Autostart
exec_always --no-startup-id swaymsg "output DP-1 res 3440x1440 pos 0 0; output DP-2 res 3440x1440 pos 3440 0; output HDMI-A-1 disable"

exec --no-startup-id systemctl --user import-environment WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec --no-startup-id fcitx5 -d
exec --no-startup-id swayidle -w timeout 1800 'qs -c noctalia-shell ipc call lockScreen lock'
exec --no-startup-id /usr/local/bin/nomod
exec --no-startup-id /usr/bin/easyeffects

# Media keys
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioStop exec playerctl play-pause
bindsym XF86AudioNext exec qs -c noctalia-shell ipc call media next
bindsym XF86AudioPrev exec qs -c noctalia-shell ipc call media previous

include ~/.config/sway/noctalia

