
# Sway Configuration
# Converted from i3 config

# Keybind modifier
set $mod Mod4

# Font for the bar (if using swaybar)
font pango:NotoMono Nerd Font 10

# Floating modifier
floating_modifier $mod

# Workspace names
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"

# Game Mode
mode "Game" {
    bindsym $mod+Shift+e mode "default"

    bindsym $mod+1 workspace $ws1
    bindsym $mod+2 workspace $ws2
    bindsym $mod+3 workspace $ws3
    bindsym $mod+4 workspace $ws4
    bindsym $mod+5 workspace $ws5
    bindsym $mod+6 workspace $ws6
    bindsym $mod+7 workspace $ws7
    bindsym $mod+8 workspace $ws8
    bindsym $mod+9 workspace $ws9

    # move to workspace
    bindsym $mod+Shift+1 move container to workspace $ws1
    bindsym $mod+Shift+2 move container to workspace $ws2
    bindsym $mod+Shift+3 move container to workspace $ws3
    bindsym $mod+Shift+4 move container to workspace $ws4
    bindsym $mod+Shift+5 move container to workspace $ws5
    bindsym $mod+Shift+6 move container to workspace $ws6
    bindsym $mod+Shift+7 move container to workspace $ws7
    bindsym $mod+Shift+8 move container to workspace $ws8
    bindsym $mod+Shift+9 move container to workspace $ws9
}

# Start programs
bindsym $mod+e exec --no-startup-id thunar
bindsym $mod+w exec --no-startup-id librewolf
bindsym $mod+Return exec --no-startup-id kitty

# Screenshots (Replaced xfce4-screenshooter with grimblast)
# Ensure 'grim' and 'slurp' are installed
bindsym Print exec --no-startup-id grimblast --notify --cursor copysave area ~/Pictures
bindsym $mod+Print exec --no-startup-id grimblast --notify --cursor copysave active ~/Pictures
bindsym $mod+Shift+Print exec --no-startup-id grimblast --notify --cursor copysave window ~/Pictures 

# Settings
bindsym $mod+Ctrl+y exec --no-startup-id xfce4-settings-manager

# Calculator
bindsym $mod+c exec --no-startup-id galculator

# Btop
bindsym $mod+n exec --no-startup-id alacritty --class btop -o "window.dimensions.lines=40" -o "window.dimensions.columns=180" -e btop

# Rofi
bindsym $mod+d exec --no-startup-id rofi -show run

# Lock Screen (Replaced xsecurelock with swaylock)
bindsym $mod+l exec --no-startup-id swaylock -f -c #000000

# Display Management (Replaced xrandr with Sway output commands)
# NOTE: Verify output names with 'swaymsg -t get_outputs'
# If your outputs are named differently (e.g., eDP-1), update the names below.

# F9: Turn off all outputs
bindsym $mod+Shift+F9 exec --no-startup-id swaymsg "output DP-2 disable; output DP-0 disable; output HDMI-0 disable"

# F12: Multi-monitor setup (DP-2, DP-0, HDMI-0)
bindsym $mod+Shift+F12 exec --no-startup-id swaymsg "output DP-2 res 3440x1440 pos 0,0; output DP-0 res 3440x1440 pos 3440,0; output HDMI-0 res 3440x1440 pos 6880,0"

# F11: Two monitors (DP-2, HDMI-0)
bindsym $mod+Shift+F11 exec --no-startup-id swaymsg "output DP-2 res 3440x1440 pos 0,0; output HDMI-0 res 3440x1440 pos 3440,0; output DP-0 disable"

# F10: Single monitor (DP-2)
bindsym $mod+Shift+F10 exec --no-startup-id swaymsg "output DP-2 res 1680x1050 pos 0,0; output DP-0 disable; output HDMI-0 disable"

# Kill focused window
bindsym $mod+q exec --no-startup-id ~/.config/scripts/kill.sh
bindsym $mod+Shift+q [con_id="__focused__" instance="^(?!dropdown_).*$"] kill

# Change focus
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focus workspace
bindsym $mod+Mod1+Right move workspace to output right
bindsym $mod+Mod1+Left move workspace to output left

# Move focus window
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Resize focus window
# Sway has built-in resize, but you used i3-resizer. 
# Here is the native Sway way to resize by pixels. 
# If you specifically need i3-resizer behavior, keep the exec, but native is smoother.
bindsym $mod+Ctrl+Right resize grow right
bindsym $mod+Ctrl+Left resize grow left
bindsym $mod+Ctrl+Up resize grow up
bindsym $mod+Ctrl+Down resize grow down

# If you prefer the exact pixel resize from i3-resizer, uncomment below and comment out the lines above:
# bindsym $mod+Ctrl+Right exec --no-startup-id i3-resizer right left 40 px
# bindsym $mod+Ctrl+Left exec --no-startup-id i3-resizer left right 40 px
# bindsym $mod+Ctrl+Up exec --no-startup-id i3-resizer up down 40 px
# bindsym $mod+Ctrl+Down exec --no-startup-id i3-resizer down up 40 px

# Toggle tiling / floating
bindsym $mod+space floating toggle

# Split in direction
bindsym $mod+v split v
bindsym $mod+h split h

# Layout fullscreen / gaps
bindsym $mod+f fullscreen toggle

# Gaps (Sway supports basic gaps)
# Note: i3gaps advanced features are not available in vanilla Sway.
bindsym $mod+KP_Add gaps inner current set 8; gaps outer current set 0
bindsym $mod+KP_Subtract gaps inner current set 0; gaps outer current set 0

# Layout split / tabbed
bindsym $mod+s layout toggle split
bindsym $mod+Shift+s layout tabbed
bindsym $mod+Ctrl+s layout tabbed

# Reload, restart, exit
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'"

# Client colors (Sway bar colors)
# client.focused | client.focused_inactive | client.unfocused | client.urgent | client.placeholder | client.background
client.focused #195092 #195092 #FFFFFF #195092 #195092
client.focused_inactive #000000 #000000 #195092 #195092 #000000
client.unfocused #000000 #000000 #195092 #195092 #000000
client.urgent #5294e2 #5294e2 #FFFFFF #5294e2 #5294e2
client.placeholder #000000 #000000 #195092 #195092 #000000
client.background #000000

# Default gaps
default_border pixel 1
default_floating_border pixel 1
gaps inner 8
gaps outer 0

# Switch to workspace
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym --whole-window $mod+button4 workspace prev
bindsym --whole-window $mod+button5 workspace next
bindsym $mod+Tab workspace next

# Switch to workspace alternative
bindsym Mod1+Shift+Ctrl+1 workspace $ws1
bindsym Mod1+Shift+Ctrl+2 workspace $ws2
bindsym Mod1+Shift+Ctrl+3 workspace $ws3
bindsym Mod1+Shift+Ctrl+4 workspace $ws4
bindsym Mod1+Shift+Ctrl+5 workspace $ws5
bindsym Mod1+Shift+Ctrl+6 workspace $ws6
bindsym Mod1+Shift+Ctrl+7 workspace $ws7
bindsym Mod1+Shift+Ctrl+8 workspace $ws8
bindsym Mod1+Shift+Ctrl+9 workspace $ws9

# Move to workspace
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9

# Move alternative (Alt)
bindsym $mod+Alt+1 move container to workspace $ws9
bindsym $mod+Alt+2 move container to workspace $ws9
bindsym $mod+Alt+3 move container to workspace $ws9
bindsym $mod+Alt+4 move container to workspace $ws9
bindsym $mod+Alt+5 move container to workspace $ws9
bindsym $mod+Alt+6 move container to workspace $ws9
bindsym $mod+Alt+7 move container to workspace $ws9
bindsym $mod+Alt+8 move container to workspace $ws9
bindsym $mod+Alt+9 move container to workspace $ws9

# Move alternative (Ctrl)
bindsym $mod+Ctrl+1 move container to workspace $ws1
bindsym $mod+Ctrl+2 move container to workspace $ws2
bindsym $mod+Ctrl+3 move container to workspace $ws3
bindsym $mod+Ctrl+4 move container to workspace $ws4
bindsym $mod+Ctrl+5 move container to workspace $ws5
bindsym $mod+Ctrl+6 move container to workspace $ws6
bindsym $mod+Ctrl+7 move container to workspace $ws7
bindsym $mod+Ctrl+8 move container to workspace $ws8
bindsym $mod+Ctrl+9 move container to workspace $ws9

# Workspaces on monitors (Assign outputs to workspaces)
# Note: Sway handles workspace-to-output assignment via 'output' directives or automatic assignment.
# The 'workspace X output Y' syntax in i3 is replaced by ensuring the workspace is created on that output.
# Sway automatically moves workspaces between outputs if you drag them, but initial assignment:
workspace $ws1 output DP-2
workspace $ws2 output DP-2
workspace $ws3 output DP-2
workspace $ws4 output DP-2
workspace $ws5 output DP-2
workspace $ws6 output DP-2
workspace $ws7 output DP-2
workspace $ws8 output DP-2
workspace $ws9 output DP-0

# Workspace assign
assign [class="discord"] $ws1
assign [class="steam" title="Steam"] $ws2
assign [class="Lutris"] $ws2
assign [class="bottles"] $ws2
assign [class="battle.net.exe"] $ws2
assign [class="riotclientux.exe"] $ws2

for_window [class=".*"] fullscreen disable

# Floating windows
for_window [class="Galculator"] floating enable
for_window [class="Pavucontrol"] floating enable
for_window [class="Nm-connection-editor"] floating enable
for_window [class="Blueman-manager"] floating enable
for_window [class="Usbimager"] floating enable
for_window [class="qt5ct"] floating enable
for_window [class="Xfce4-.*settings.*"] floating enable
for_window [class="Xfce4-.*manager.*"] floating enable
for_window [title="Emulator"] floating enable
for_window [class="Nvidia-settings"] floating enable
for_window [class="btop"] floating enable
for_window [class="pika-backup"] floating enable

# Steam specific
for_window [class="steam" title="Friends List"] floating enable
for_window [class="steam" title="Settings"] floating enable

# Games
for_window [class="trackmania.exe"] floating enable
for_window [title="World of Warracft"] windowed enable
for_window [class="Minecraft*"] floating enable
for_window [class="d2r.exe"] floating enable
for_window [class="Project Zomboid"] floating enable
for_window [class="scrcpy"] floating enable
for_window [title="Vampire Survivors"] floating enable
for_window [title="Brighter Shores"] floating enable
for_window [title="Brighter Shores"] resize set 1920 900

# Borders
for_window [title="xfce4-panel"] border none
for_window [class="OxygenNotIncluded"] border none
for_window [class="^steam_app.*"] border none

# Sticky
for_window [class="firefox" title="Picture-in-Picture"] sticky enable

# Custom macros
bindsym F11 --release exec --no-startup-id killall buy.sh

# Autostart
exec_always --no-startup-id nm-applet
exec_always --no-startup-id blueman-applet
exec_always --no-startup-id deskflow

# Wallpaper (feh is X11, use swaybg or swww)
# Uncomment one of the following:
# exec_always --no-startup-id swaybg -i ~/pictures/wallpapers/32.jpg
# exec_always --no-startup-id swww-daemon; swww img ~/pictures/wallpapers/32.jpg

exec --no-startup-id fcitx5 -d

# Initial Display Setup (Run once on startup)
# This sets the default multi-monitor layout on startup
exec --no-startup-id swaymsg "output DP-2 res 3440x1440 pos 0,0; output DP-0 res 3440x1440 pos 3440,0; output HDMI-0 res 3440x1440 pos 6880,0"

exec --no-startup-id xfce4-panel -d
exec --no-startup-id xautolock -time 30 -locker swaylock
exec --no-startup-id /usr/local/bin/nomod
exec --no-startup-id /usr/bin/easyeffects

# Layouts (i3-msg -> swaymsg)
exec --no-startup-id "swaymsg 'workspace 1; append_layout /home/used/.config/i3/workspace-1.json'"

# Workspace 2
exec --no-startup-id "swaymsg 'workspace 2; exec steam'"

# Workspace 1
exec --no-startup-id "swaymsg 'workspace 1; exec discord'"
exec --no-startup-id "swaymsg 'workspace 1; exec librewolf https://music.youtube.com/'"
exec --no-startup-id "swaymsg 'workspace 1; exec alacritty'"

# Sway Bar Configuration (Added because i3 config didn't have one, but defined colors)
bar {
    position top
    status_command waybar # Or use 'i3status' if you prefer i3status, but waybar is more common in Sway
    colors {
        statusline #FFFFFF
        background #195092
        separator #195092
    }
    mode hide
    fonts {
        pango:NotoMono Nerd Font 10
    }
}
